@* InfoTip.razor - A small info icon with tooltip that works on desktop (hover) and mobile (tap).
   When ChildContent is supplied, that content becomes the trigger instead of the info icon. *@

@if (showPopover)
{
    <div class="info-tip-backdrop" @onclick="ClosePopover" @ontouchend="ClosePopover"></div>
}

<span class="info-tip" @onclick="TogglePopover" @onclick:stopPropagation="true" @ontouchend:stopPropagation="true">
    @if (ChildContent is null)
    {
        <span class="info-icon" title="@Text">ⓘ</span>
    }
    else
    {
        <span class="info-tip-content" title="@Text">@ChildContent</span>
    }
    @if (showPopover)
    {
        <span class="info-popover" @onclick:stopPropagation="true">@Text</span>
    }
</span>

@code {
    /// <summary>Tooltip text shown on hover (desktop) and in the popover (tap).</summary>
    [Parameter]
    public string Text { get; set; } = "";

    /// <summary>Optional trigger content; when null the standard info icon is shown.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool showPopover = false;

    private void TogglePopover()
    {
        showPopover = !showPopover;
    }

    private void ClosePopover()
    {
        showPopover = false;
    }
}
