@inherits LayoutComponentBase
@implements IDisposable
@inject LayoutState LayoutState
<div class="page @(LayoutState.CompactNavOnLandscapePhone ? "compact-nav-landscape" : null)">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    /// <summary>Re-renders when a page changes the layout settings.</summary>
    protected override void OnInitialized() => LayoutState.Changed += OnLayoutStateChanged;

    // async void: an event handler; any exception surfaces through the renderer rather than being lost.
    private async void OnLayoutStateChanged() => await InvokeAsync(StateHasChanged);

    /// <summary>Stops observing the layout settings.</summary>
    public void Dispose() => LayoutState.Changed -= OnLayoutStateChanged;
}
