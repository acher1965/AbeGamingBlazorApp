@implements IDisposable
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">AbeGaming</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ftpbattle">
                <span class="bi bi-flag-fill-nav-menu" aria-hidden="true"></span> FtP Battle
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="pogbattle">
                <span class="bi bi-shield-fill-nav-menu" aria-hidden="true"></span> PoG Battle
            </NavLink>
        </div>
        <div class="nav-item px-3">
            @* stopPropagation: opening the submenu must not close the narrow-screen menu. *@
            <button type="button" id="navTnwToggle" class="nav-link nav-group-toggle @(IsTnwPage && !tnwExpanded ? "active" : null)"
                    aria-expanded="@(tnwExpanded ? "true" : "false")"
                    @onclick="ToggleTnwSubmenu" @onclick:stopPropagation="true">
                <span class="bi bi-lightning-charge-fill-nav-menu" aria-hidden="true"></span> TNW <span class="beta-tag">BETA</span>
                <span class="nav-group-chevron @(tnwExpanded ? "open" : null)" aria-hidden="true"></span>
            </button>
        </div>
        @if (tnwExpanded)
        {
            <div class="nav-item nav-subitem px-3">
                <NavLink class="nav-link" href="tnwbattle">
                    <span class="bi bi-lightning-charge-fill-nav-menu" aria-hidden="true"></span> Land Battle
                </NavLink>
            </div>
            <div class="nav-item nav-subitem px-3">
                <NavLink class="nav-link" href="tnwnaval">
                    <span class="bi bi-water-nav-menu" aria-hidden="true"></span> Naval Battle
                </NavLink>
            </div>
            <div class="nav-item nav-subitem px-3">
                <NavLink class="nav-link" href="tnwsiege">
                    <span class="bi bi-shield-lock-fill-nav-menu" aria-hidden="true"></span> Siege
                </NavLink>
            </div>
        }
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="about">
                <span class="bi bi-info-circle-fill-nav-menu" aria-hidden="true"></span> About
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="contact">
                <span class="bi bi-envelope-fill-nav-menu" aria-hidden="true"></span> Contact
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="install">
                <span class="bi bi-download-nav-menu" aria-hidden="true"></span> Install
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="changelist">
                <span class="bi bi-journal-text-nav-menu" aria-hidden="true"></span> Change List
            </NavLink>
        </div>
        <div class="nav-item px-3 pt-3">
            <small class="text-light opacity-50">v@(AppVersion)</small>
        </div>
    </nav>
</div>

@code {
    private const string TnwRoutePrefix = "tnw";

    private bool collapseNavMenu = true;
    private bool tnwExpanded;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private static string AppVersion => typeof(NavMenu).Assembly.GetName().Version?.ToString(3) ?? "0.0.0";

    /// <summary>True on one of The Napoleonic Wars pages.</summary>
    private bool IsTnwPage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith(TnwRoutePrefix, StringComparison.OrdinalIgnoreCase);

    /// <summary>Opens the TNW submenu when the app starts on a TNW page, and on every later visit to one.</summary>
    protected override void OnInitialized()
    {
        tnwExpanded = IsTnwPage;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (IsTnwPage && !tnwExpanded)
        {
            tnwExpanded = true;
            StateHasChanged();
        }
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void ToggleTnwSubmenu()
    {
        tnwExpanded = !tnwExpanded;
    }

    /// <summary>Stops observing navigation.</summary>
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
