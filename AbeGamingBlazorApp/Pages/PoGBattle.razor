@page "/pogbattle"
@using AbeGaming.GameLogic
@using AbeGaming.GameLogic.PoG
@using PoGBattleModel = AbeGaming.GameLogic.PoG.PoGBattle
@implements IDisposable
@inject IJSRuntime JS
@inject LayoutState LayoutState

<PageTitle>PoG Battle Calculator</PageTitle>

<h1 class="h3 mb-3">Paths of Glory - Battle Calculator</h1>

<div class="card mb-2">
    <div class="card-body py-2">
        <div class="row g-2">
            <div class="col-12 col-md-4">
                <label class="form-label form-label-sm mb-1">
                    <InfoTip Text="Mountain/Swamp shift offensive fire 1L. Forest/Desert affect retreat/advance. Trench effects are cumulative.">Terrain</InfoTip>
                </label>
                <select id="pogTerrain" class="form-select form-select-sm" @bind="Terrain">
                    @foreach (Terrain option in Enum.GetValues<Terrain>())
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-4">
                <label class="form-label form-label-sm mb-1">
                    <InfoTip Text="Trench 1: offensive fire 1L, defensive fire 1R. Trench 2: offensive fire 2L, defensive fire 1R.">Trench</InfoTip>
                </label>
                <input id="pogTrench" type="number" class="form-control form-control-sm" @bind="Trench" onfocus="this.select()" min="0" max="2" />
            </div>
            <div class="col-6 col-md-4">
                <label class="form-label form-label-sm mb-1">
                    <InfoTip Text="The fort's printed CF, added to the defender's factors (12.2.3). A besieged fort keeps its CF. A fort with no defending units cannot be flanked and gets no trench benefit (15.1.6).">Fortress</InfoTip>
                </label>
                <select id="pogFortressLevel" class="form-select form-select-sm" @bind="FortressLevel">
                    @foreach (FortressLevel option in Enum.GetValues<FortressLevel>())
                    {
                        <option value="@option">@option.DisplayName()</option>
                    }
                </select>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-3 mt-2">
            <div class="form-check form-check-inline mb-0">
                <input class="form-check-input" type="checkbox" id="pogAttemptFlank" @bind="AttemptFlankAttack" disabled="@(!CanConfigureFlank)" />
                <label class="form-check-label small" for="pogAttemptFlank">
                    <InfoTip Text="Requires attack from 2+ spaces. Flank succeeds on 4+ after flank DRM. Without 'Detailed units', the side firing second fires with its factors minus the Loss Number it took - an approximation.">Attempt flank</InfoTip>
                </label>
            </div>
            <div class="form-check form-check-inline mb-0">
                <input class="form-check-input" type="checkbox" id="pogAllAttackersInSinai" @bind="IsAllAttackersInSinai" />
                <label class="form-check-label small" for="pogAllAttackersInSinai">
                    <InfoTip Text="Applies -3 DRM to attacker per rule 12.2.7.">All attackers in Sinai</InfoTip>
                </label>
            </div>
            <div class="form-check form-check-inline mb-0">
                <input class="form-check-input" type="checkbox" id="pogDetailedUnits" @bind="IsDetailed" />
                <label class="form-check-label small" for="pogDetailedUnits">
                    <InfoTip Text="@DetailedTip">Detailed units</InfoTip>
                </label>
            </div>
            @if (IsDetailed)
            {
                <div class="d-flex align-items-center gap-1">
                    <label class="small mb-0" for="pogAttackerFaction">
                        <InfoTip Text="@AttackerFactionTip">Attacker</InfoTip>
                    </label>
                    <select id="pogAttackerFaction" class="form-select form-select-sm w-auto" value="@AttackerFaction" @onchange="OnAttackerFactionChanged">
                        @foreach (PoGFaction faction in Enum.GetValues<PoGFaction>())
                        {
                            <option value="@faction">@PoGUnitCatalog.Faction(faction).Name</option>
                        }
                    </select>
                </div>
            }
        </div>
        @if (AttemptFlankAttack)
        {
            <div class="mt-2" style="max-width: 18rem;">
                <label class="form-label form-label-sm mb-1">
                    <InfoTip Text="+1 per eligible extra attacking space beyond the pinning space.">Flank DRM</InfoTip>
                </label>
                <input id="pogFlankAttackDrm" type="number" class="form-control form-control-sm" @bind="FlankAttackDrm" onfocus="this.select()" min="0" max="3" />
            </div>
        }
    </div>
</div>

<div class="row g-2 mb-2">
    <div class="col-6">
        <PoGSideInput SideName="Attacker"
                      Icon="🗡️"
                      HeaderColor="primary"
                      FactorsInfoTip="Total attacking factors."
                      OosInfoTip="OOS units may not attack."
                      FactorsInputId="pogAttackerFactors"
                      IsDetailed="IsDetailed"
                      @bind-Units="AttackerUnits"
                      MaxUnits="PoGDetailedForces.MaxAttackers"
                      Faction="AttackerFaction"
                      UnitIdPrefix="pogAttacker"
                      @bind-FireTable="AttackerFireTable"
                      @bind-Factors="AttackerFactors"
                      @bind-DRM="AttackerDrm" />
    </div>
    <div class="col-6">
        <PoGSideInput SideName="Defender"
                      Icon="🛡️"
                      HeaderColor="danger"
                      FactorsInfoTip="Total defending factors excluding fortress bonus."
                      OosInfoTip="OOS defenders cannot benefit from combat cards."
                      FactorsInputId="pogDefenderFactors"
                      IsDetailed="IsDetailed"
                      @bind-Units="DefenderUnits"
                      FortCf="@FortressLevel.CombatFactors()"
                      MaxUnits="PoGDetailedForces.MaxDefenders"
                      Faction="AttackerFaction.Opponent()"
                      UnitIdPrefix="pogDefender"
                      @bind-FireTable="DefenderFireTable"
                      @bind-Factors="DefenderFactors"
                      @bind-DRM="DefenderDrm" />
    </div>
</div>

@if (!CanConfigureFlank)
{
    <div class="alert alert-info py-2 mb-2">
        Flank attacks are not allowed into Mountain/Marsh or into Trenches.
    </div>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger py-2 mb-2">@ErrorMessage</div>
}

<div class="d-grid gap-2 mb-3">
    <button id="pogCalculateExactStats" class="btn btn-primary btn-lg" @onclick="CalculateExactStats">
        📈Calculate Exact Stats
    </button>
    <button id="pogRollSingleBattle" class="btn btn-secondary" @onclick="CalculateBattleResult">
        🎲Roll 1 Battle
    </button>
</div>

<div id="resultsSection">
    @if (ExactStats is not null && LastExactStatsBattle == CurrentBattle)
    {
        <PoGStatsDisplay Stats="ExactStats"
                         Title="📈Exact Stats"
                         BorderColor="primary"
                         HeaderBgColor="primary" />
    }

    @if (BattleResult is not null && LastBattleResultBattle == CurrentBattle)
    {
        <div class="card @GetResultCardClass() mb-3">
            <div class="card-header py-2">
                <strong>Single Battle Result</strong>
            </div>
            <div class="card-body py-2">
                <div class="row">
                    <div class="col-12 col-md-6">
                        <p class="fs-5 fw-bold mb-1">
                            @if (BattleResult.Winner == Winner.Attacker)
                            {
                                <span class="text-success">🗡️Attacker Wins</span>
                            }
                            else if (BattleResult.Winner == Winner.Defender)
                            {
                                <span class="text-danger">🛡️Defender Wins</span>
                            }
                            else
                            {
                                <span class="text-secondary">🤝Draw</span>
                            }
                        </p>
                        @if (BattleResult.Winner == Winner.Attacker)
                        {
                            <div class="small">
                                Defender retreat: <strong>@BattleResult.DefenderRetreatLength</strong>
                                @if (BattleResult.DefenderCanIgnoreRetreat)
                                {
                                    <span class="badge bg-warning text-dark ms-1">Retreat can be cancelled (extra step loss)</span>
                                }
                            </div>
                            <div class="small">
                                Attacker advance (max): <strong>@BattleResult.AdvanceMaxLength</strong>
                            </div>
                        }
                    </div>
                    <div class="col-12 col-md-6 small">
                        <div>
                            🎲Attacker die: @BattleResult.AttackerDieRoll
                            @if (BattleResult.AttackerModifiedDieRoll != BattleResult.AttackerDieRoll)
                            {
                                <span> (@BattleResult.AttackerModifiedDieRoll mod)</span>
                            }
                        </div>
                        <div>
                            🎲Defender die: @BattleResult.DefenderDieRoll
                            @if (BattleResult.DefenderModifiedDieRoll != BattleResult.DefenderDieRoll)
                            {
                                <span> (@BattleResult.DefenderModifiedDieRoll mod)</span>
                            }
                        </div>
                        <div>🗡️Hits to Defender: <strong>@BattleResult.HitsByAttacker</strong></div>
                        <div>🛡️Hits to Attacker: <strong>@BattleResult.HitsByDefender</strong></div>
                        @if (LastBattleResultBattle?.Detailed is not null)
                        {
                            <div id="pogDetailedResult">
                                Steps lost: attacker <strong>@BattleResult.AttackerStepsLost</strong>,
                                defender <strong>@BattleResult.DefenderStepsLost</strong>
                                @if (BattleResult.DefenderFireTable is FireTable defenderTable && defenderTable != InitialDefenderFireTable(LastBattleResultBattle))
                                {
                                    <span class="badge bg-info text-dark ms-1">Defender fired on the @defenderTable table</span>
                                }
                                @if (BattleResult.DefenderEliminated)
                                {
                                    <span class="badge bg-dark ms-1">Defenders eliminated</span>
                                }
                                @if (BattleResult.FortDestroyed)
                                {
                                    <span class="badge bg-dark ms-1">Fort destroyed</span>
                                }
                                @if (BattleResult.Winner == Winner.Attacker && !BattleResult.AttackerHasFullStrengthUnit)
                                {
                                    <span class="badge bg-warning text-dark ms-1">No full strength attacker left: no retreat or advance</span>
                                }
                            </div>
                        }
                        @if (BattleResult.FlankAttackAttempted)
                        {
                            <div>
                                Flank: roll @BattleResult.FlankAttackDieRoll -> @BattleResult.FlankAttackModifiedDieRoll
                                @if (BattleResult.FlankAttackSucceeded)
                                {
                                    <span class="badge bg-success ms-1">Succeeded</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary ms-1">Failed</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Terrain _terrain = Terrain.Clear;
    private Terrain Terrain
    {
        get => _terrain;
        set
        {
            _terrain = value;
            EnforceFlankBlockingRules();
        }
    }
    private FortressLevel FortressLevel = FortressLevel.None;
    private int _trench;
    private int Trench
    {
        get => _trench;
        set
        {
            _trench = PoGBattleInputRules.ClampTrench(value);
            EnforceFlankBlockingRules();
        }
    }

    private bool AttemptFlankAttack;
    private int _flankAttackDrm;
    private int FlankAttackDrm
    {
        get => _flankAttackDrm;
        set => _flankAttackDrm = PoGBattleInputRules.ClampFlankAttackDrm(value);
    }

    private bool IsAllAttackersInSinai;

    private bool IsFlankBlockedByTerrain => Terrain is Terrain.Mountain or Terrain.Marsh;
    private bool IsFlankBlockedByTrench => Trench > 0;
    private bool CanConfigureFlank => !IsFlankBlockedByTerrain && !IsFlankBlockedByTrench;

    private FireTable AttackerFireTable = FireTable.Army;
    private FireTable DefenderFireTable = FireTable.Army;

    private int _attackerFactors = 6;
    private int AttackerFactors
    {
        get => _attackerFactors;
        set => _attackerFactors = PoGBattleInputRules.ClampFactors(value);
    }

    private int _defenderFactors = 6;
    private int DefenderFactors
    {
        get => _defenderFactors;
        set => _defenderFactors = PoGBattleInputRules.ClampFactors(value);
    }

    private int _attackerDrm;
    private int AttackerDrm
    {
        get => _attackerDrm;
        set => _attackerDrm = PoGBattleInputRules.ClampDrm(value);
    }

    private int _defenderDrm;
    private int DefenderDrm
    {
        get => _defenderDrm;
        set => _defenderDrm = PoGBattleInputRules.ClampDrm(value);
    }

    private PoGBattleResult? BattleResult;
    private PoGStats? ExactStats;
    private PoGBattleModel? LastExactStatsBattle;
    private PoGBattleModel? LastBattleResultBattle;
    private string? ErrorMessage;

    private void EnforceFlankBlockingRules()
    {
        if (CanConfigureFlank)
            return;

        AttemptFlankAttack = false;
        FlankAttackDrm = 0;
    }

    private PoGBattleModel CurrentBattle => CreateBattle();

    private PoGBattleModel CreateBattle() => new(
        new BattleSideInfo(AttackerFireTable, AttackerFactors, AttackerDrm),
        new BattleSideInfo(DefenderFireTable, DefenderFactors, DefenderDrm),
        Terrain,
        FortressLevel,
        Trench,
        AttemptFlankAttack,
        FlankAttackDrm,
        IsAllAttackersInSinai,
        IsDetailed ? new PoGDetailedForces(AttackerUnits, DefenderUnits) : null);

    public const string DetailedTip =
        "List each side's units instead of total factors. Losses are then taken step by step as in the rules (12.4): " +
        "a reduced Army eliminated is replaced by a Corps if one is in the Reserve Box (Res.), an attacking BEF, MEF, RU CAU, AUS or CND unit " +
        "takes the first loss (12.4.5), the side firing second after a flank attack " +
        "fires with its real survivors (possibly on the Corps table), a retreat needs a full strength attacker left (12.5.1), " +
        "and cancelling a retreat needs a defending step left (12.5.3). Without it, these are approximated from the factors.";

    private const string AttackerFactionTip =
        "Each side lists only its own units; the defender is the other side. Changing it restarts both lists.";

    /// <summary>The table the defender starts on in a detailed-mode battle.</summary>
    private static FireTable InitialDefenderFireTable(PoGBattleModel battle) =>
        PoGSideForce.FromUnits(battle.Detailed!.Defenders, battle.FortressLevel.CombatFactors()).FireTable;

    // Detailed mode: the units of each side.
    private const int StartingUnitsPerSide = 3;

    private bool _isDetailed;
    private bool IsDetailed
    {
        get => _isDetailed;
        set
        {
            _isDetailed = value;
            // The unit lists need the whole width of a phone in landscape.
            LayoutState.CompactNavOnLandscapePhone = value;
        }
    }

    private PoGFaction AttackerFaction = PoGFaction.CentralPowers;
    private EquatableList<PoGUnit> AttackerUnits = StartingUnits(PoGFaction.CentralPowers);
    private EquatableList<PoGUnit> DefenderUnits = StartingUnits(PoGFaction.AlliedPowers);

    /// <summary>The starting setup of a side: three full strength default Armies, each with a reserve Corps.</summary>
    private static EquatableList<PoGUnit> StartingUnits(PoGFaction faction) =>
        new(Enumerable.Repeat(new PoGUnit(PoGUnitCatalog.Faction(faction).DefaultUnit), StartingUnitsPerSide));

    private void OnAttackerFactionChanged(ChangeEventArgs e)
    {
        if (!Enum.TryParse(e.Value?.ToString(), out PoGFaction faction) || faction == AttackerFaction)
            return;

        AttackerFaction = faction;
        AttackerUnits = StartingUnits(faction);
        DefenderUnits = StartingUnits(faction.Opponent());
    }

    /// <summary>Gives the sidebar back to other pages.</summary>
    public void Dispose() => LayoutState.CompactNavOnLandscapePhone = false;

    private async Task ScrollToResults()
    {
        await JS.InvokeVoidAsync("abegamingUi.scrollIntoViewById", "resultsSection");
    }

    private async Task CalculateBattleResult()
    {
        ErrorMessage = null;

        try
        {
            PoGBattleModel battle = CreateBattle();
            Span<int> dice = Dice.RollOneDieRepeatedly(AttemptFlankAttack ? 3 : 2);
            BattleResult = battle.Outcome(
                attackerDieRoll: dice[0],
                defenderDieRoll: dice[1],
                flankAttackDieRoll: AttemptFlankAttack ? dice[2] : null);
            LastBattleResultBattle = battle;
            await ScrollToResults();
        }
        catch (Exception ex)
        {
            BattleResult = null;
            LastBattleResultBattle = null;
            ErrorMessage = ex.Message;
        }
    }

    private async Task CalculateExactStats()
    {
        ErrorMessage = null;
        BattleResult = null;
        LastBattleResultBattle = null;

        try
        {
            PoGBattleModel battle = CreateBattle();
            ExactStats = PoGExactStats.Calculate(battle);
            LastExactStatsBattle = battle;
            await ScrollToResults();
        }
        catch (Exception ex)
        {
            ExactStats = null;
            LastExactStatsBattle = null;
            ErrorMessage = ex.Message;
        }
    }

    private string GetResultCardClass()
    {
        if (BattleResult is null)
            return "";

        return BattleResult.Winner switch
        {
            Winner.Attacker => "border-success",
            Winner.Defender => "border-danger",
            _ => "border-secondary"
        };
    }
}
